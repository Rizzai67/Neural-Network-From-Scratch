import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import csv
from sklearn.metrics import confusion_matrix
import seaborn as sns
train_df=pd.read_csv("mnist_train.csv")
test_df=pd.read_csv("mnist_test.csv")
X_train=train_df.drop("label",axis=1).values.T/255.0
y_train=train_df["label"].values.reshape(1,-1)
X_test=test_df.drop("label",axis=1).values.T/255.0
y_test=test_df["label"].values.reshape(1,-1)
print(f"Training examples: {X_train.shape[1]}, Test examples: {X_test.shape[1]}")


def one_hot_encode(y,num_classes=10):
    one_hot=np.zeros((num_classes,y.size))
    one_hot[y,np.arange(y.size)]
    return one_hot
def relu(Z):
    return np.maximum(0,Z)
def relu_derivative(Z):
    return(Z>0).astype(float)
def softmax(Z):
    expZ = np.exp(Z - np.max(Z,axis=0,keepdims=True))
    return expZ / expZ.sum(axis=0, keepdims=True)
def initial_parameters(n_x,n_h,n_y):
    np.random.seed(1)
    W1=np.random.randn(n_h,n_x)*np.sqrt(2. /n_x)
    b1=np.zeros((n_h,1))
    W2=np.random.randn(n_y,n_h)*np.sqrt(2. /n_h)
    b2=np.zeros((n_y,1))
    return {"W1":W1,"b1":b1,"W2":W2,"b2":b2}

def forward_propagation(X,parameters):
    W1,b1,W2,b2= parameters.values()
    Z1=np.dot(W1,X)+b1
    A1=relu(Z1)
    Z2=np.dot(W2,A1)+b2
    A2=softmax(Z2)
    return A2 , (Z1,A1,Z2,A2)
def compute_cost(A2,Y):
    m=Y.shape[1]
    return (-1/m) * np.sum(Y * np.log(A2 + 1e-8))
def back_propagation(X,Y,parameters,cache):
    W1, b1, W2, b2 = parameters.values()
    Z1, A1, Z2, A2 = cache
    m = X.shape[1]
    dZ2=A2-Y
    dW2=(1/m)*np.dot(dZ2,A1.T)
    db2=(1/m)*np.sum(dZ2,axis=1,keepdims=True)
    dA1=np.dot(W2.T,dZ2)
    dZ1=dA1*relu_derivative(Z1)
    dW1=(1/m)*np.dot(dZ1,X.T)
    db1=(1/m)*np.sum(dZ1,axis=1,keepdims=True)

    return {"dW1": dW1, "db1": db1, "dW2": dW2, "db2": db2}

def update_parameters(parameters,grads,lr=0.01):
    for key in parameters.keys():
        parameters[key]-=lr*grads["d"+key]
    return parameters

def predict(X,parameters):
    A2,_=forward_propagation(X,parameters)
    return np.argmax(A2,axis=0)

def model(X,Y,n_h,iterations=40000,lr=0.1):
    n_x=X.shape[0]
    n_y=10
    Y_oh=one_hot_encode(Y.flatten())
    parameters=initial_parameters(n_x,n_h,n_y)
    costs=[]

    for i in range(iterations):
        A2,cache=forward_propagation(X,parameters)    
        cost=compute_cost(A2,Y_oh)
        grads=back_propagation(X,Y_oh,parameters,cache)
        parameters=update_parameters(parameters,grads,lr)
        if i%100==0:
            costs.append(cost)
            print(f"iteration{i}:cost={cost:.4f}")
    return parameters,costs

## trainingg the modellllllllll
parameters,costs=model(X_train,y_train,n_h=64,iterations=4000,lr=0.01)

# ------------------------------------------------------------
# 1️⃣1️⃣ Visualize training loss curve
# ------------------------------------------------------------
plt.figure(figsize=(8, 5))
plt.plot(costs, marker='o')
plt.title("Training Loss Curve")
plt.xlabel("Iterations (x100)")
plt.ylabel("Cost")
plt.grid(True)
plt.show()

# ------------------------------------------------------------
# 1️⃣2️⃣ Evaluate model accuracy
# ------------------------------------------------------------
preds = predict(X_test, parameters)
acc = np.mean(preds == y_test.flatten()) * 100
print(f"✅ Test Accuracy: {acc:.2f}%")

# ------------------------------------------------------------
# 1️⃣3️⃣ Confusion Matrix
# ------------------------------------------------------------
cm = confusion_matrix(y_test.flatten(), preds)
plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues')
plt.title("Confusion Matrix")
plt.xlabel("Predicted")
plt.ylabel("True")
plt.show()

# ------------------------------------------------------------
# 1️⃣4️⃣ Visualize random predictions
# ------------------------------------------------------------
def visualize_predictions(X, y_true, y_pred, n=10):
    idx = np.random.choice(X.shape[1], n, replace=False)
    plt.figure(figsize=(15, 3))
    for i, j in enumerate(idx):
        img = X[:, j].reshape(28, 28)
        plt.subplot(1, n, i + 1)
        plt.imshow(img, cmap='gray')
        color = "green" if y_true[0, j] == y_pred[j] else "red"
        plt.title(f"Pred: {y_pred[j]}\nTrue: {y_true[0, j]}", color=color)
        plt.axis('off')
    plt.show()

visualize_predictions(X_test, y_test, preds, n=10)